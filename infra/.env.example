# Zuum environment template — copy to .env (never commit real values)

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Database (Render Postgres) ---
DATABASE_URL=postgres://user:pass@host:5432/zuum

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- JWT ---
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=14

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Mapbox ---
MAPBOX_ACCESS_TOKEN=
MAPBOX_STYLE_URL=mapbox://styles/zuum/zuum-blr

# --- Storage (S3-compatible) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Flutter builds (injected via --dart-define, NOT in this file) ---
# ENV=mock|dev|prod
# API_BASE_URL=https://api.zuum.example/api/v1
# WS_BASE_URL=wss://api.zuum.example/ws
# MAPBOX_ACCESS_TOKEN=pk....

# --- Routing (Valhalla) ---
ROUTING_PROVIDER=valhalla
ROUTING_BASE_URL=https://valhalla1.openstreetmap.de
ROUTING_API_KEY=
ROUTING_TIMEOUT_MS=4500
ROUTING_CACHE_TTL=300
DISPATCH_USE_MATRIX=0

# --- Places (OSM geocoding) ---
PHOTON_URL=https://photon.komoot.io
NOMINATIM_URL=https://nominatim.openstreetmap.org

# --- Flutter map style (dart-define, not a secret) ---
# MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
